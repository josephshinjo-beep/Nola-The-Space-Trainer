# Copy this file to .env.local and fill in the values from:
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. "nasa" uses real NASA DONKI data through /api/space-weather
# (with simulated data as the backup). Leave empty for simulated data only.
VITE_SPACE_DATA_SOURCE=

# ---------------------------------------------------------------------------
# SERVER-ONLY settings. These are read by the functions in /api and must be
# set in Vercel (Project -> Settings -> Environment Variables), or in
# .env.local for `npm run dev`. Never give them a VITE_ prefix:
# anything starting with VITE_ is visible to everyone who opens the site.
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=     switches on NOLA's AI answers using OpenRouter's FREE models (secret)
# OPENROUTER_MODEL=       optional, free model id(s) to try first, comma-separated
# GEMINI_API_KEY=         alternative to OpenRouter (secret; from Google AI Studio)
# AI_MODEL=               optional, a Gemini model name to try first
# NASA_API_KEY=           optional, free from https://api.nasa.gov
